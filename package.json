{
  "name": "taskmanager",
  "version": "1.0.0",
  "main": "main.js",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^38.1.2",
    "electron-reload": "^1.2.1",
    "wait-on": "^9.0.1"
  },
  "scripts": {
    "ng:serve": "cd taskmanager-frontend && ng serve",
    "electron:start": "cross-env NODE_ENV=development concurrently \"npm run ng:serve\" \"wait-on http://localhost:4200 && npx electron .\"",
    "start": "npm run electron:start",
    "build": "cd taskmanager-frontend && ng build --configuration production"
  }
}
